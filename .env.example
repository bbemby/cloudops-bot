# =============================================================================
# CloudOps Bot 配置样例
#
#   cp .env.example .env    然后按下面的说明逐项填写
#   python manage.py gen-secret     # 生成 SECRET_KEY
#   python main.py --check          # 检查是否漏填
#
# 说明：
#   * 这个文件只放"占位值"，任何真实密钥都不要提交进 Git；
#   * 进程环境变量优先级高于 .env（Docker/K8s 里直接注入即可）；
#   * 所有变量都可以不写，代码里的默认值见 cloudops/config.py。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 必填项：没有这三项机器人起不来
# -----------------------------------------------------------------------------
# 在 Telegram 里找 @BotFather 发送 /newbot 获得，形如 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# 管理员（可执行创建/销毁等写操作）的 Telegram 数字 ID，多个用逗号分隔。
# 查询方式：在 Telegram 里找 @userinfobot 发送任意消息。
BOT_ADMIN_IDS=

# 用于加密落库的云凭证（Fernet 密钥）。用 `python manage.py gen-secret` 生成。
# 注意：一旦更换，数据库里已有的凭证将无法解密，需要重新 /bind。
SECRET_KEY=

# -----------------------------------------------------------------------------
# 2. 运行参数（可选）
# -----------------------------------------------------------------------------
# 只读观察者：能看列表/状态，不能创建销毁
BOT_READONLY_IDS=
# 未授权用户（guest）收到拒绝提示，可执行 python manage.py promote <id> 提权

# 界面语言：zh / en
BOT_LANGUAGE=zh
# 时间显示时区（列表、日志里的时间都按它渲染）
DISPLAY_TIMEZONE=Asia/Shanghai
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志同时写文件（留空只输出到 stdout）
LOG_FILE=
# 启动时打印欢迎横幅
STARTUP_BANNER=true
# 用户被拒绝访问（越权尝试）时是否私聊通知管理员
NOTIFY_ADMINS_ON_DENIED=false

# -----------------------------------------------------------------------------
# 3. 存储与限流
# -----------------------------------------------------------------------------
DATABASE_PATH=./data/cloudops.db
# 每个用户每分钟最多发起的操作次数，0 表示不限流
RATE_LIMIT_PER_MINUTE=20
# 危险操作确认码有效期（秒）
CONFIRM_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# 4. 默认云平台与实例创建
# -----------------------------------------------------------------------------
# digitalocean / aws / mock
DEFAULT_PROVIDER=digitalocean
DEFAULT_INSTANCE_NAME=auto-ops-node
# 单次最多创建多少台
CREATE_MAX_COUNT=3
# 轮询等待公网 IP 的总超时与间隔（秒）
CREATE_TIMEOUT_SECONDS=900
CREATE_POLL_INTERVAL_SECONDS=8
# 访问云厂商 API 的超时与重试
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRIES=3

# -----------------------------------------------------------------------------
# 5. Telegram 连接细节（一般不用改）
# -----------------------------------------------------------------------------
# 自建 API 网关（例如反代）时改这里
TELEGRAM_API_BASE=https://api.telegram.org
# 网络受限时走代理，形如 http://127.0.0.1:7890
TELEGRAM_PROXY=
# 长轮询超时（秒）
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_REQUEST_TIMEOUT=35
TELEGRAM_RETRIES=3
# 收到指令后先发 "正在输入…"
TELEGRAM_SHOW_TYPING=true

# -----------------------------------------------------------------------------
# 6. DigitalOcean 默认值
# -----------------------------------------------------------------------------
DO_DEFAULT_REGION=sgp1
DO_DEFAULT_SIZE=s-1vcpu-1gb
DO_DEFAULT_IMAGE=debian-12-x64
# 逗号分隔的 SSH Key 指纹（在 DO 控制台可查），例如 12:34:56:...
DO_SSH_KEYS=
# 新建实例自动打上的标签
DO_TAGS=
DO_ENABLE_IPV6=false
DO_ENABLE_MONITORING=true
DO_ENABLE_BACKUPS=false

# -----------------------------------------------------------------------------
# 7. AWS EC2 默认值
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
# 也接受 AWS 的标准变量名 AWS_DEFAULT_REGION（只在 AWS_REGION 未设时生效）
# /list 需要扫描的区域（逗号分隔）。留空表示只用 AWS_REGION
AWS_REGIONS=
AWS_DEFAULT_INSTANCE_TYPE=t3.micro
# 留空则用下面的 SSM 参数路径解析最新 Amazon Linux 2023 AMI
AWS_DEFAULT_AMI=
AWS_AMI_SSM_PARAMETER=/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64
AWS_KEY_NAME=
AWS_SECURITY_GROUP_IDS=
AWS_SUBNET_ID=
AWS_IAM_INSTANCE_PROFILE=
# 是否给新建实例分配公网 IP
AWS_ASSOCIATE_PUBLIC_IP=true

# -----------------------------------------------------------------------------
# 8. 开箱即用的凭证预置（可选）
#
# 填了这里，Bot 首次启动会自动把凭证加密写进数据库并激活，省去在群里 /bind。
# 不填也完全可以——群聊里执行 /bind 效果一样，而且更安全（密钥不落 .env）。
# -----------------------------------------------------------------------------
BOOTSTRAP_CREDENTIAL_LABEL=default
# DigitalOcean Personal Access Token（Read+Write）
DIGITALOCEAN_TOKEN=
# AWS 访问密钥（建议用最小权限的 IAM 子账号，仅 ec2:* 与 ssm:GetParameter）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 使用临时凭证（STS）时才需要
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# 9. 演示模式（无需云账号即可跑通全流程）
# -----------------------------------------------------------------------------
# 打开后多出一个 mock 云平台：/create mock、/list mock 全部在本机 JSON 文件里模拟
ENABLE_MOCK_PROVIDER=false
MOCK_STATE_PATH=./data/mock-cloud.json

# -----------------------------------------------------------------------------
# 10. Web 管理面板（容器内端口 9878，compose 已把 9878 映射到宿主机同名端口）
# -----------------------------------------------------------------------------
# 面板与 Bot 共用同一个数据库：聊天窗口里建的实例、面板上刷一下就出现。
# 关闭面板设 WEB_ENABLED=false（容器也就不会监听任何端口）。
WEB_ENABLED=true

# 容器内监听地址。0.0.0.0 才能被宿主机访问；只给本机反代用时改成 127.0.0.1
WEB_HOST=0.0.0.0

# 容器内端口。改这个值要同步改 compose 的端口映射（或用 WEB_PORT 环境变量覆盖）
WEB_PORT=9878

# 面板登录口令。**留空则每次启动随机生成并打印在容器日志里**（docker compose logs 可查）。
# 固定口令请填这里，建议 12 位以上；改口令会立刻让已登录的会话失效。
WEB_ADMIN_PASSWORD=

# 会话有效期（秒），默认 8 小时
WEB_SESSION_TTL_SECONDS=28800

# 面板挂在 HTTPS 反向代理后面时置 true（让浏览器只在加密连接上回传会话 cookie）
WEB_SECURE_COOKIE=false

# 只读模式：面板只允许查看，销毁实例 / 增删凭证 / 改角色一律拒绝（403）
WEB_READONLY=false

# 浏览器标签页与页面标题
WEB_TITLE=CloudOps 管理面板

# 反向代理会改写来源地址时置 true（登录限速按 X-Forwarded-For 计数）。
# 直连时保持 false —— 否则伪造的 XFF 头可以绕过登录限速。
WEB_TRUST_PROXY=false

# 登录限速：同一来源在窗口内失败达到上限后拒绝
WEB_MAX_LOGIN_ATTEMPTS=5
WEB_LOGIN_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# 11. 元信息（可留空）
# -----------------------------------------------------------------------------
USER_AGENT=
